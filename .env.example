DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads_desk
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=30
DATABASE_IDLE_TIMEOUT_SECONDS=20
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret
NEXTAUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_NAME=Owner Admin
ALLOWED_EMAIL_DOMAINS=example.com
CRM_INTAKE_SECRET=
CRM_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRM_IMPORT_COMMIT_BATCH_SIZE=50
LEAD_STORE_TEST_DATABASE_URL=

# Legacy compatibility variables retained for the existing runtime.
# Prefer DATABASE_URL and the auth variables above for new Leads Desk work.
ADMIN_ALLOWED_EMAILS=
LEAD_EXPORT_ALLOWED_EMAILS=

# Optional integration credentials. Configure only the connectors enabled for this deployment.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
GOOGLE_ADS_WEBHOOK_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_WEBHOOK_SECRET=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=
SENDER_API_KEY=
SENDER_DEFAULT_GROUP_ID=
CRM_NOTIFICATION_WEBHOOK_URL=
SENDER_WAITLIST_GROUP_ID_WORK_RELOCATE=
SENDER_WAITLIST_GROUP_ID_VISIT_TOURISM=
SENDER_WAITLIST_GROUP_ID_BUSINESS_TRAVEL=
