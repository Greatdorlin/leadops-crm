DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@postgres:5432/leads_desk
POSTGRES_DB=leads_desk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=30
DATABASE_IDLE_TIMEOUT_SECONDS=20

AUTH_SECRET=replace-with-at-least-32-random-bytes
# Google login is optional and disabled until all three values are configured.
ENABLE_GOOGLE_LOGIN=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=https://leads.example.com
NEXT_PUBLIC_APP_URL=https://leads.example.com
CRM_PUBLIC_BASE_URL=https://leads.example.com

INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_NAME=Owner Admin
ALLOWED_EMAIL_DOMAINS=example.com
