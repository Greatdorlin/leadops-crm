{
  "name": "leads-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed:defaults": "node --import tsx src/scripts/seed-defaults.ts",
    "db:seed:defaults:full": "node --import tsx src/scripts/seed-defaults.ts --with-custom-fields",
    "db:seed:demo": "node --import tsx src/scripts/seed-demo.ts",
    "auth:invite-initial-admin": "node --import tsx src/scripts/invite-initial-admin.ts",
    "load:smoke": "node scripts/load-smoke.mjs",
    "verify": "npm run lint && npm run check:env && npm run typecheck && npm run test:coverage && npm run audit && npm run db:check && npm run build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:coverage": "c8 --all --include=\"src/**/*.ts\" --include=\"src/**/*.tsx\" --exclude=\"src/**/*.test.ts\" --reporter=text-summary --reporter=json-summary --reporter=lcov npm test && node scripts/check-coverage.mjs",
    "audit": "npm audit --audit-level=high",
    "check:env": "node scripts/check-env-example.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "db:check": "node scripts/check-migration-drift.mjs",
    "db:prepare:assistant": "node --import tsx src/scripts/prepare-assistant.ts",
    "db:prepare:assistant-controls": "node --import tsx src/scripts/prepare-assistant.ts --controls",
    "db:prepare:inbox": "node --import tsx src/scripts/prepare-inbox.ts",
    "inbox:sync": "node --import tsx src/scripts/inbox-sync.ts",
    "build:cloudflare": "npm run build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^11.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^14.9.0",
    "googleapis": "^172.0.0",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.14.2",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "4.6.6",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "uuid": "11.1.1",
    "glob": "^14.0.2",
    "minimatch@>=7": "^11.0.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "next-auth": {
      "nodemailer": "^10.3.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
