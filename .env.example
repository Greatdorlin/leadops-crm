DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads_desk
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=30
DATABASE_IDLE_TIMEOUT_SECONDS=20
AUTH_SECRET=replace-with-a-long-random-secret
# Google is secondary and remains disabled unless this flag is explicitly true.
ENABLE_GOOGLE_LOGIN=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_INVITATION_TTL_HOURS=72
NEXTAUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_NAME=Owner Admin
ALLOWED_EMAIL_DOMAINS=example.com
CRM_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRM_IMPORT_COMMIT_BATCH_SIZE=50
LEAD_STORE_TEST_DATABASE_URL=

# Legacy compatibility variables retained for the existing runtime.
# Prefer DATABASE_URL and the auth variables above for new Leads Desk work.
ADMIN_ALLOWED_EMAILS=
LEAD_EXPORT_ALLOWED_EMAILS=

# Optional integration credentials. Configure only the connectors enabled for this deployment.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
GOOGLE_ADS_WEBHOOK_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
TIKTOK_WEBHOOK_SECRET=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_LEAD_SYNC_OWNER_URN=
LINKEDIN_API_VERSION=
# Email marketing providers require a server-side deployment adapter before credentials are added.
CRM_NOTIFICATION_WEBHOOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional observability. Sentry account project DSN; no telemetry is sent without it.
SENTRY_DSN=
# Release commit/version used to group errors; supplied by your deployment pipeline.
APP_RELEASE=
# Pino log level: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Legacy intake shared secret, only for endpoints explicitly configured to use it.
# Generate with: openssl rand -base64 32. Prefer per-form source keys.
CRM_INTAKE_SECRET=
# Compatibility aliases: use AUTH_SECRET and DATABASE_URL above for new deployments.
# These can be left empty. Obtain URLs from your Postgres provider, never commit them.
NEXTAUTH_SECRET=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
# Optional build troubleshooting only; disables webpack disk cache when true.
LEADS_DESK_DISABLE_WEBPACK_CACHE=false
# Optional read-only load harness credentials, never expose these to the browser.
# Supply an existing authorized session cookie OR bearer value only when running load:smoke.
LOAD_COOKIE=
LOAD_AUTHORIZATION=
# NODE_ENV is managed by Next.js (development/test/production); do not override for normal setup.
NODE_ENV=
